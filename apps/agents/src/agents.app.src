{application, agents, [
    {description, "Advanced Self-Optimizing Distributed Multi-Agent System with Quantum Coordination"},
    {vsn, "0.3.0"},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/arthurcolle/agents.erl"}]},
    {maintainers, ["Arthur M. Collé"]},
    {registered, [
        agents_sup,
        agent_time_authority,
        agent_tools,
        agent_registry,
        agent_supervisor,
        super_agent_sup,
        dynamic_runtime_sup,
        dynamic_supervisors_sup,
        dynamic_supervisor_manager,
        quantum_runtime,
        quantum_protocol,
        cluster_orchestrator,
        lockfree_coordination
    ]},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        crypto,
        public_key,
        jsx,
        jiffy,
        gproc,
        mnesia,
        openai,
        poolboy,
        uuid
    ]},
    {mod, {agents_app, []}},
    {env, [
        {auto_start_groups, [chat, completions, embeddings]},
        {output_dir, "/tmp/openai-erlang"},
        {default_model, <<"gpt-4.1">>},
        {quantum_coordination, true},
        {lockfree_primitives, true},
        {self_optimization, true},
        {numa_awareness, true},
        {thermal_monitoring, true}
    ]}
]}.
